<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="5dp"
    android:paddingEnd="8dp"
    android:paddingBottom="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="网关用量"
            android:textColor="@color/fg"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/muted"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chip_today"
            style="@style/Chip"
            android:text="今日" />

        <TextView
            android:id="@+id/chip_7d"
            style="@style/Chip"
            android:text="7日" />

        <TextView
            android:id="@+id/chip_30d"
            style="@style/Chip"
            android:text="30日" />

        <TextView
            android:id="@+id/chip_all"
            style="@style/Chip"
            android:text="全部" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/refresh"
            style="@style/Chip"
            android:layout_marginEnd="0dp"
            android:text="刷新" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <LinearLayout
            style="@style/MetricCard"
            android:layout_weight="1.4"
            android:layout_marginEnd="4dp">

            <TextView style="@style/MetricLabel" android:text="总 Token" />

            <TextView android:id="@+id/m_token"
            style="@style/MetricValue"
            android:text="—" />
        </LinearLayout>

        <LinearLayout
            style="@style/MetricCard"
            android:layout_marginEnd="4dp">

            <TextView style="@style/MetricLabel" android:text="缓存命中" />

            <TextView android:id="@+id/m_cache"
            style="@style/MetricValue"
            android:text="—" />
        </LinearLayout>

        <LinearLayout
            style="@style/MetricCard"
            android:layout_marginEnd="4dp">

            <TextView style="@style/MetricLabel" android:text="请求数" />

            <TextView android:id="@+id/m_calls"
            style="@style/MetricValue"
            android:text="—" />
        </LinearLayout>

        <LinearLayout style="@style/MetricCard">

            <TextView style="@style/MetricLabel" android:text="错误数" />

            <TextView android:id="@+id/m_errors"
            style="@style/MetricValue"
            android:text="—" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:background="@drawable/card_bg"
        android:orientation="vertical"
        android:paddingStart="2dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp">

        <ai.usemagpie.dashboard.ui.SeriesChartView
            android:id="@+id/chart"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/card_bg"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingTop="3dp"
        android:paddingEnd="6dp"
        android:paddingBottom="3dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ranking"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never" />

            <TextView
                android:id="@+id/ranking_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="暂无数据"
                android:textColor="@color/muted"
                android:textSize="10sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/breakdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/muted"
        android:textSize="9.5sp" />
</LinearLayout>
